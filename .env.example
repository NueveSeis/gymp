# Copia este archivo como .env para desarrollo local.
# En Dokploy, pon estas variables en la pestaña "Environment" de la app.

# MySQL de Hostinger (hPanel → Bases de datos → MySQL remoto: autoriza la IP de tu servidor Dokploy)
# El mismo formato que usaba Prisma. connection_limit es opcional (por defecto 10).
DATABASE_URL="mysql://USUARIO:CLAVE@HOST_HOSTINGER:3306/NOMBRE_BD?connection_limit=10"

# Clave para firmar las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Carpeta donde se guardan imágenes y videos subidos.
# En Dokploy monta un volumen en esta ruta para no perder archivos al redeployar.
UPLOAD_DIR="/app/uploads"

# Zona horaria del gimnasio (define qué es "hoy")
APP_TIMEZONE="America/Mexico_City"

# Aplica migraciones de /database/migrations al arrancar (true por defecto)
AUTO_MIGRATE="true"

# Solo si la base está vacía: usuario admin inicial que se crea automáticamente
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="cambia-esto"
